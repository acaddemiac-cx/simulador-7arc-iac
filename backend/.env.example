# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" (con las llaves reales) a un repositorio público.

# --- Proveedor de IA ---
# Por defecto el backend usa la API de OpenAI (platform.openai.com).
OPENAI_API_KEY=sk-...

# Si en cambio quieres usar Azure OpenAI, descomenta y completa estas 3 variables
# y pon AI_PROVIDER=azure. El código ya soporta ambos casos (ver server.js).
# AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Modelo a usar si AI_PROVIDER=openai (o se deja vacío)
OPENAI_MODEL=gpt-4o-mini

# --- Acceso de administrador ---
# Contraseña compartida que debes entregar únicamente a los administradores
# (por ejemplo a Nataly Bustamante y Carlos Manquillo). Cualquiera que la
# tenga podrá ver el tablero de todo el equipo y editar el catálogo.
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura

# --- Servidor ---
PORT=3000

# Dominios permitidos para CORS (separados por coma). Usa "*" si vas a servir
# el frontend desde el mismo backend (recomendado, es lo que hace este proyecto).
CORS_ORIGIN=*

# --- Correos de felicitación automáticos ---
# Si configuras estas variables SMTP, cuando un comercial obtenga una
# puntuación igual o mayor a NOTIFY_THRESHOLD en el Simulador 7 ARC, se le
# enviará automáticamente un correo de felicitación (en HTML, con colores IAC).
# Si las dejas vacías, la app funciona igual pero no envía ningún correo.
#
# Puedes usar tu propio Microsoft 365 / Outlook (smtp.office365.com, puerto
# 587), Gmail con una "contraseña de aplicación", SendGrid, Amazon SES, etc.
#
# Ejemplo para Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=simulador7arc@iaclatam.com
# SMTP_PASS=la-contraseña-o-app-password-de-esa-cuenta
# SMTP_FROM=simulador7arc@iaclatam.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Puntuación mínima (0-100) para disparar el correo de felicitación.
NOTIFY_THRESHOLD=85

# Correos que además reciben copia de cada felicitación (por ejemplo los
# gerentes/admins), separados por coma. Opcional.
ADMIN_NOTIFY_EMAILS=
